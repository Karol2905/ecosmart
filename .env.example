# =====================================================================
# Variables PÚBLICAS del frontend (se incrustan en el bundle del navegador)
# Solo las variables con prefijo VITE_ llegan al cliente.
# =====================================================================
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# anon key: es pública por diseño; la seguridad real la imponen las políticas RLS.
VITE_SUPABASE_ANON_KEY=tu-anon-key

# =====================================================================
# ⛔ NUNCA declares aquí la service_role key ni con prefijo VITE_.
# Esa clave salta TODAS las políticas RLS. Solo debe vivir en:
#   - Supabase Edge Functions (Deno.env.get('SUPABASE_SERVICE_ROLE_KEY'))
#   - Servidores/CI propios, como secreto del entorno
# El script scripts/check-secrets.mjs bloquea el build si la detecta.
# =====================================================================
